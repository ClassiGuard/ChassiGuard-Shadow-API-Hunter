{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shadow-api-hunter.enterprise/schemas/v1/policy_snapshot.schema.json",
  "title": "PolicySnapshot",
  "description": "Cryptographically signed policy snapshot for edge node autonomy",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "version_tag",
    "sequence_number",
    "tenant_id",
    "issued_at_utc",
    "valid_until_utc",
    "offline_lease_hours",
    "detection_rules",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "policy_id": {
      "type": "string",
      "format": "uuid"
    },
    "version_tag": {
      "type": "string"
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string"
    },
    "target_node_id": {
      "type": "string"
    },
    "issued_at_utc": {
      "type": "integer"
    },
    "valid_until_utc": {
      "type": "integer"
    },
    "offline_lease_hours": {
      "type": "integer",
      "minimum": 168
    },
    "detection_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "name", "category", "severity", "condition_expression", "is_active"],
        "properties": {
          "rule_id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string" },
          "condition_expression": { "type": "string" },
          "is_active": { "type": "boolean" },
          "applicable_environments": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "active_scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope_id", "approved_by_user_id", "approval_timestamp_utc", "expires_at_utc", "target_asset_id"],
        "properties": {
          "scope_id": { "type": "string" },
          "approved_by_user_id": { "type": "string" },
          "approval_timestamp_utc": { "type": "integer" },
          "expires_at_utc": { "type": "integer" },
          "target_asset_id": { "type": "string" },
          "max_requests_per_second": { "type": "integer" },
          "max_total_requests": { "type": "integer" },
          "allowed_while_disconnected": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "revoked_policy_versions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "signature": {
      "type": "object",
      "required": ["key_id", "algorithm", "signature_hex", "signed_at_utc"],
      "properties": {
        "key_id": { "type": "string" },
        "algorithm": {
          "type": "string",
          "enum": ["ED25519", "ECDSA_P256_SHA256", "RSA_PSS_SHA256"]
        },
        "signature_hex": { "type": "string" },
        "signed_at_utc": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
